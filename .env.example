# Copy to .env and edit:  copy .env.example .env
# このファイルを .env にコピーして編集してください

PORT=4100
HOST=0.0.0.0

# Public base URL for selfie / media links (phone app must reach this)
# スマホから届く公開ベース URL（セルフィー・メディア用）
PUBLIC_API_BASE=http://23.27.186.171:4100

# Admin dashboard login / 管理画面ログイン
ADMIN_EMAIL=admin@joshikai.local
ADMIN_PASSWORD=admin123

# MongoDB connection (required) / MongoDB 接続（必須）
# Local:  mongodb://127.0.0.1:27017/joshikai
# Atlas:  mongodb+srv://USER:PASS@cluster.mongodb.net/joshikai
MONGODB_URI=mongodb://127.0.0.1:27017/joshikai

# Resend.com — required for Forgot Password emails
# パスワードリセットメール用（https://resend.com/api-keys）
RESEND_API_KEY=re_xxxxxxxx
# Use a verified domain sender in production / 本番は検証済みドメインを使用
RESEND_FROM_EMAIL=Joshikai <noreply@yourdomain.com>
